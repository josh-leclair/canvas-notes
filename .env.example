# Required. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Keep true whenever users connect over HTTPS. Set false only for local/LAN HTTP.
COOKIE_SECURE=true

# Displayed in the application.
INSTANCE_NAME=Canvas Notes

# Optional. Leave empty to use the bundled PostgreSQL service. For an existing
# PostgreSQL server, set this and use docker-compose.external-db.yml as described
# in the README. Percent-encode reserved characters in the username/password.
DATABASE_URL=

# Public deployment only: a hostname whose DNS points to this server.
DOMAIN=notes.example.com

# Local port exposed on loopback by the base Compose file.
APP_PORT=8080
BIND_ADDRESS=127.0.0.1

# Optional capture bot.
TELEGRAM_BOT_TOKEN=

# Optional OpenAI-compatible embedding endpoint.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=768

# Optional remote transcription endpoint. Leave the URL empty for local
# transcription in the worker container.
WHISPER_BASE_URL=
WHISPER_MODEL=small
WHISPER_API_KEY=

# Optional OpenAI-compatible chat endpoint.
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=
